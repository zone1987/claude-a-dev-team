{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "hello-world",
  "type": "registry:block",
  "title": "Hello World",
  "description": "A simple hello world component.",
  "author": "Acme <hi@acme.com>",
  "dependencies": ["zod", "reka-ui"],
  "registryDependencies": ["button", "input", "@acme/utils"],
  "files": [
    {
      "path": "registry/new-york/hello-world/HelloWorld.vue",
      "type": "registry:component"
    },
    {
      "path": "registry/new-york/hello-world/useHello.ts",
      "type": "registry:composable"
    }
  ],
  "cssVars": {
    "theme": { "font-heading": "Poppins, sans-serif" },
    "light": { "brand": "oklch(0.6 0.2 250)" },
    "dark": { "brand": "oklch(0.7 0.2 250)" }
  },
  "css": {
    "@layer components": {
      ".card": { "background-color": "var(--color-card)", "border-radius": "var(--radius)" }
    }
  },
  "envVars": {
    "API_BASE_URL": "https://api.example.com"
  },
  "meta": { "category": "marketing" },
  "docs": "Run `npm run setup` after installing this item."
}
