{
  "hooks": {
    "PostToolUseFailure": [
      {
        "matcher": "mcp__reui__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/MCP-FALLBACK.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/PREMIUM-GATE.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
